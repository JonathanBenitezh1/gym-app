# Copiá este archivo como .env y completá los valores reales.
# Las variables VITE_ se incrustan en el build del frontend.

# URL del backend (API REST)
# En desarrollo: http://localhost:3000
# En produccion: https://api.tudominio.com
VITE_API_URL=http://localhost:3000

# URL del backend para el socket en tiempo real (normalmente la misma que arriba)
VITE_SOCKET_URL=http://localhost:3000
